# ===================== 项目配置 & MAC 地址管理 =====================
substitutions:
  project_name: "vvt1"
  build_time: "Unknown"
  {% for dev in devices %}
  mac_{{ dev.id }}: "{{ dev.mac }}"
  {% endfor %}

esphome:
  name: ble-3
  friendly_name: "${project_name}"
  comment: "${project_name} - Build: ${build_time}"
  includes:
    - midea_ble_controller.h
  on_boot:
    priority: 600
    then:
      - lambda: |-
          {% for dev in devices %}
          set_device_mac({{ loop.index0 }}, "${mac_{{ dev.id }}}");
          {% endfor %}
          ble_set_send_function([](const std::string& hex) { id(tx).send_hex(hex); });
          mqtt_set_publish_function([](const char* topic, const char* payload) { id(bemfa).publish(topic, payload); });
          register_entity_sync([](int idx, const MideaDevice& dev) {
              {% for dev in devices %}
              if (idx == {{ loop.index0 }}) {
                  id({{ dev.id }}_light_on).publish_state(dev.light_on); id({{ dev.id }}_fan_on).publish_state(dev.fan_on);
                  id({{ dev.id }}_brt).publish_state(dev.brightness); id({{ dev.id }}_ct).publish_state(dev.color_temp); id({{ dev.id }}_spd).publish_state(dev.fan_speed);
                  id({{ dev.id }}_brt_n).publish_state(dev.brightness); id({{ dev.id }}_ct_n).publish_state(dev.color_temp); id({{ dev.id }}_spd_n).publish_state(dev.fan_speed);
                  id({{ dev.id }}_light_sw).publish_state(dev.light_on); id({{ dev.id }}_fan_sw).publish_state(dev.fan_on);
              } {% if not loop.last %}else {% endif %}
              {% endfor %}
          });

# ===================== ESP32 =====================
esp32:
  board: esp32dev
  flash_size: 4MB
  framework:
    type: esp-idf
    sdkconfig_options:
      CONFIG_FREERTOS_UNICORE: y
      CONFIG_BT_ENABLED: y
      CONFIG_BT_BLE_ENABLED: y

logger:
  baud_rate: 0
  level: INFO

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  fast_connect: true
  power_save_mode: none
  ap:
    ssid: "BLE-GW Fallback"
    password: "12345678"

captive_portal:
web_server:
  port: 80
ota:
  - platform: esphome
api:
  reboot_timeout: 0s
  services:
    - service: send_raw_hex
      variables:
        hex_data: string
      then:
        - lambda: 'id(tx).send_hex(hex_data);'

external_components:
  - source:
      type: local
      path: components

ble_tx:
  id: tx

esp32_ble:
  io_capability: none
  enable_on_boot: true

bluetooth_proxy:
  active: true
  cache_services: true

# ===================== 全局变量 =====================
globals:
  {% for dev in devices %}
  - id: {{ dev.id }}_current_ct_kelvin
    type: int
    restore_value: no
    initial_value: '4600'
  {% endfor %}

# ===================== 巴法云 MQTT =====================
mqtt:
  id: bemfa
  broker: bemfa.com
  port: 9501
  username: !secret mqtt_username
  password: !secret mqtt_password
  client_id: !secret mqtt_client_id
  keepalive: 30s
  discovery: false
  birth_message:
  will_message:
  on_connect:
    - delay: 2s
    - lambda: 'publish_all_devices();'
  on_message:
    {% for dev in devices %}
    - topic: "{{ dev.light_topic }}"
      then:
        - lambda: 'handle_light_mqtt({{ loop.index0 }}, x);'
    - topic: "{{ dev.fan_topic }}"
      then:
        - lambda: 'handle_fan_mqtt({{ loop.index0 }}, x);'
    {% endfor %}

# ===================== BLE 扫描 =====================
esp32_ble_tracker:
  scan_parameters:
    interval: 160ms
    window: 60ms
    active: false
  on_ble_advertise:
    - then:
        - lambda: |-
            auto datas = x.get_manufacturer_datas();
            for (auto &data : datas) parse_ble_advertisement(data.data);

# ===================== 定时任务 =====================
interval:
  - interval: 50ms
    then:
      - lambda: 'tick_ble_queue();'
  - interval: 60s
    then:
      - lambda: 'tick_heartbeat();'

# ===================== 使用 packages 引入每个房间的实体 =====================
packages:
  {% for dev in devices %}
  room_{{ dev.id }}: !include { file: templates/room.yaml, vars: { room_id: {{ dev.id }}, room_name: "{{ dev.name }}", device_index: {{ loop.index0 }} } }
  {% endfor %}

# ===================== 全局传感器 =====================
sensor:
  - platform: uptime
    name: "Uptime"
    update_interval: 60s
  - platform: internal_temperature
    name: "ESP32 Temp"
    unit_of_measurement: "°C"
    accuracy_decimals: 1
    update_interval: 60s
  - platform: wifi_signal
    name: "WiFi dBm"
    id: wifi_signal_db
    update_interval: 60s
  - platform: copy
    source_id: wifi_signal_db
    name: "WiFi Pct"
    filters:
      - lambda: return min(max(2*(x+100.0),0.0),100.0);
    unit_of_measurement: "%"
    accuracy_decimals: 0

text_sensor:
  - platform: template
    name: "Build Time"
    lambda: 'return {"${build_time}"};'
    update_interval: 3600s
  - platform: version
    name: "ESPHome Ver"
    hide_timestamp: true
  - platform: wifi_info
    ip_address:
      name: "ESP IP"
    ssid:
      name: "ESP SSID"

button:
  - platform: restart
    name: "Restart GW"
    icon: mdi:restart
    entity_category: diagnostic
